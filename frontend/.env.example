# Public site URL (used for canonical URLs, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# API base URL used by the Next.js server (server-to-server) and the browser
API_BASE_URL=http://localhost:7071
NEXT_PUBLIC_API_BASE_URL=http://localhost:7071

# Optional: map provider key, CAPTCHA site key
NEXT_PUBLIC_MAP_KEY=
NEXT_PUBLIC_CAPTCHA_SITE_KEY=
